# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Encrypts LocalClaude's data and your 2FA secret. Generate once with: openssl rand -base64 32
# Keep a copy somewhere safe: without it the data in ./data can't be opened.
LOCALCLAUDE_SECRET=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" (the long token).
CLOUDFLARE_TUNNEL_TOKEN=

# Your user and group id on this machine (run: id -u; id -g), so files in ./workspace belong to you.
LC_UID=1000
LC_GID=1000
